# Local container-only values. Copy to .env.container.local and replace every value.
# Keep this file out of Git; the root .gitignore already excludes *.env.
POSTGRES_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-random-32-byte-hex-value
COOKIE_SECRET=replace-with-a-different-random-32-byte-hex-value
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-third-random-32-byte-hex-value
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
