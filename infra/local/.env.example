# Local container-only values. Copy to infra/local/.env.local and replace every value.
# Use URL-safe characters in POSTGRES_PASSWORD because Compose inserts it into DATABASE_URL.
# Generate a safe value with: openssl rand -hex 32
# Replace every value with a local-only value before starting the stack.
POSTGRES_PASSWORD=
JWT_SECRET=replace-with-a-random-32-byte-hex-value
COOKIE_SECRET=replace-with-a-different-random-32-byte-hex-value
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-third-random-32-byte-hex-value
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
